#!/bin/sh
# GLang launcher (Linux / macOS):
#   glang <file.glang>   run the program
GLANG_HOME="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "$JAVA_HOME" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA="java"
fi

if ! command -v "$JAVA" >/dev/null 2>&1; then
    echo "GLang needs Java 21 or newer, but '$JAVA' was not found." >&2
    exit 2
fi

exec "$JAVA" -jar "$GLANG_HOME/lib/glang.jar" "$@"
